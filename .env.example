VIVI_PROVIDER=openrouter
OPENAI_API_KEY=
VIVI_MODEL=gpt-5.4-2026-03-05
# 이 연결 방식을 쓰려면 VIVI_PROVIDER=openrouter로 설정한다. 이때 VIVI_MODEL은 사용하지 않는다.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4
# 검증한 운영 설정: GPT-5.4 low와 압축한 근거·초안 형식.
# 출력 상한 16000은 잘림을 피하기 위한 여유다. 사용하지 않은 토큰은 과금되지 않는다.
# SDK 재시도와 공급사 대체 호출은 사용하지 않는다.
VIVI_REASONING_EFFORT=low
VIVI_MAX_OUTPUT_TOKENS=16000
VIVI_REASONING_EXCLUDE=true
# 고객별 실제 달러 예산이다. 과제의 AI-M 회당 $0.018 환산 단가와 별도로 관리한다.
VIVI_ACTUAL_MAX_MONTHLY_COGS_USD=20
VIVI_ACTUAL_FIXED_MONTHLY_COST_USD=10.5
# 고정 인프라 비용에 포함되지 않은 Langfuse 추가 배분액만 넣는다.
VIVI_LANGFUSE_INCREMENTAL_MONTHLY_COST_USD=0
# 향후 선택형 Jev 비교 평가용이다. 현재 에이전트에서는 사용하지 않는다.
TYPESAFE_API_KEY=

# 선택형 로컬 Langfuse 관측 설정. 실행: python3 scripts/setup_langfuse.py
# 설정 스크립트가 무작위 인증값을 .env에 추가한다. 이 예제 파일에는 비밀값을 복사하지 않는다.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_WEB_PORT=3000
LANGFUSE_MINIO_PORT=9090
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_ORG_ID=vivi-local
LANGFUSE_INIT_PROJECT_ID=vivi-agent
LANGFUSE_INIT_USER_EMAIL=vivi@localhost.local
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
